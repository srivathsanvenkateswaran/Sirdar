{"$expect":"thread/start"}
{"$reply":{"thread":{"id":"th-3","sessionId":"th-3","cwd":"/work"},"model":"gpt-5-codex","approvalPolicy":"untrusted"}}
{"$expect":"turn/start"}
{"$reply":{"turn":{"id":"tn-3","items":[],"status":"inProgress"}}}
// A command the workspace allow-listed.
{"$expect_request":"item/commandExecution/requestApproval","id":101,"params":{"threadId":"th-3","turnId":"tn-3","itemId":"cmd_1","command":"rg -n TODO","cwd":"/work"}}
