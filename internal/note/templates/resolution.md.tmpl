customer: {{.meta.Customer}}
customer_id: {{.meta.CustomerID}}
service: {{.meta.Service}}
resolution_type: {{.doc.resolution.resolutionType}}
status: proposed
pr: {{if $cc}}{{fill "pr" $cc.pr}}{{else}}{{fill "pr" ""}}{{end}}
pr_status: {{if $cc}}{{fill "pr_status" $cc.prStatus}}{{else}}{{fill "pr_status" ""}}{{end}}
approved_by: {{fill "approved_by" ""}}
applied_by: {{fill "applied_by" ""}}
applied_at: {{fill "applied_at" ""}}
verified_at: {{fill "verified_at" ""}}
{{- if or .meta.Links.Triage .meta.Links.RCA}}
related:
{{- if .meta.Links.Triage}}
  - "[[{{.meta.Links.Triage}}]]"
{{- end}}
{{- if .meta.Links.RCA}}
  - "[[{{.meta.Links.RCA}}]]"
{{- end}}
{{- end}}
run: {{.meta.RunID}}
