node_modules/
.env
.env.*
*.log
.DS_Store

# Go
/sirdar
/dist/
.sirdar/runs/

# Frontend build output, staged into the Go binary by `make ui`.
# The placeholders are committed so `go build ./...` works on a fresh checkout.
desktop/frontend/dist/*
!desktop/frontend/dist/.gitkeep
internal/httpapi/ui/dist/*
!internal/httpapi/ui/dist/.gitkeep

# Wails artefacts
desktop/build/bin/
# Cut from desktop/build/appicon.png by `wails build` whenever it is absent,
# so the logo has one source and a Windows build does not dirty the tree.
desktop/build/windows/icon.ico
desktop/frontend/wailsjs/
desktop/frontend/package.json.md5
*.tsbuildinfo

# mkdocs build output. site/ is the landing page and is committed, so the
# docs build is pointed somewhere else by mkdocs.yml's site_dir.
/.mkdocs-site/

# Claude Code agent worktrees
.claude/worktrees/
